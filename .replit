run = "bash backend/replit_start.sh"
entrypoint = "backend/replit_app.py"
modules = ["python-3.12", "web", "bash"]

[[ports]]
localPort = 8080
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash backend/replit_start.sh"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[deployment]
run = ["bash", "backend/replit_start.sh"]
deploymentTarget = "cloudrun"
